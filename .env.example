# Copy outside the repository to /etc/sunriver-intake.env and set real secrets there.
ENABLE_UPLOADS=0
PUBLIC_ORIGIN=https://sunriver.hymecymeyseh.fun
UPLOAD_DIR=/var/lib/sunriver-intake/submissions
ALERT_QUEUE_DIR=/var/lib/sunriver-intake/pending-alerts
TMPDIR=/var/lib/sunriver-intake/tmp

# Cloudflare Turnstile: required before ENABLE_UPLOADS=1.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP STARTTLS; notification email contains only a random submission reference.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=
